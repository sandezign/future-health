{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatientRecord",
  "description": "Standardized primary care patient record with longitudinal cardiorenal parameters",
  "type": "object",
  "properties": {
    "patient_id": { "type": "string" },
    "age": { "type": "integer", "minimum": 18, "maximum": 120 },
    "sex": { "type": "string", "enum": ["male", "female"] },
    "has_diabetes": { "type": "boolean" },
    "has_hypertension": { "type": "boolean" },
    "systolic_bp": { "type": "number", "minimum": 60, "maximum": 250 },
    "diastolic_bp": { "type": "number", "minimum": 40, "maximum": 150 },
    "uacr": { 
      "type": "number", 
      "description": "Urine Albumin-to-Creatinine Ratio in mg/g",
      "minimum": 0 
    },
    "dipstick_protein": {
      "type": "string",
      "enum": ["negative", "trace", "1+", "2+", "3+", "4+"]
    },
    "creatinine_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "serum_creatinine": { "type": "number", "minimum": 0.2, "maximum": 20.0 }
        },
        "required": ["timestamp", "serum_creatinine"]
      },
      "minItems": 1
    }
  },
  "required": ["patient_id", "age", "sex", "has_diabetes", "has_hypertension", "systolic_bp", "creatinine_history"]
}
